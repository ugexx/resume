---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  metric: string;
  metricLabel: string;
}

const { title, description, metric, metricLabel } = Astro.props;
---

<Base title={`${title} — Colton Fouch`} description={description}>
  <Nav />
  <main class="relative">
    <div class="grid-bg absolute inset-x-0 top-0 h-[520px] pointer-events-none" aria-hidden="true"></div>

    <article class="case-body container-x relative max-w-[860px] pt-[clamp(48px,8vw,96px)] pb-24">
      <a href="/#work" class="inline-flex items-center gap-2 font-mono text-[13px] text-text-dim hover:text-text transition-colors">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 8H3M7.5 3.5 3 8l4.5 4.5" /></svg>
        cd ../work
      </a>

      <h1 class="mt-8 text-[clamp(34px,5vw,54px)] font-semibold leading-[1.08] tracking-[-0.035em]">{title}</h1>
      <p class="mt-5 text-[18px] leading-[1.7] text-text-dim max-w-[62ch]">{description}</p>

      <div class="mt-8 mb-14 inline-flex items-center gap-3 card px-4 py-3 font-mono text-[13px]">
        <span class="text-accent-text">{metric}</span>
        <span class="text-text-faint">// {metricLabel}</span>
      </div>

      <slot />

      <footer class="mt-16 pt-8 border-t border-border flex flex-wrap justify-between gap-4">
        <a href="/#work" class="font-mono text-[13px] text-text-dim hover:text-text transition-colors">← All case studies</a>
        <a href="mailto:info@coltonfouch.com" class="font-mono text-[13px] text-accent-text hover:text-text transition-colors">info@coltonfouch.com</a>
      </footer>
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  /* The case study pages carry the old label styles; map them onto the terminal system. */
  .case-body h2 {
    font-family: var(--font-mono);
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    color: var(--color-accent-text) !important;
  }
  .case-body h2::before { content: "// "; color: var(--color-text-faint); }
  .case-body .text-accent { color: var(--color-accent-text); }
  .case-body .rounded-xl { border-radius: 8px; }
</style>
