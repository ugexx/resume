---
const facts = [
  { key: "Role", value: "Sr. Platform Manager, Patagonia" },
  { key: "Fleet", value: "2,000+ endpoints" },
  { key: "MDM", value: "Jamf Pro + Intune" },
  { key: "Provisioning", value: "< 20 min, zero-touch" },
  { key: "Auth", value: "Platform SSO, passwordless" },
  { key: "Location", value: "Ventura, CA" },
];
---

<section id="home" class="hero">
  <div class="container-x">
    <h1>
      <span>Hi, I'm Colton Fouch.</span>
      <span>I keep 2,000+ people working.</span>
    </h1>

    <p class="lede">
      I run endpoint strategy, identity, and live production infrastructure for a global hybrid workforce. Zero-touch deployment, passwordless sign-in, and town halls that don't drop.
    </p>

    <div class="actions">
      <a href="#work" class="btn btn-primary glow">
        View case studies
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" /></svg>
      </a>
      <a href="mailto:info@coltonfouch.com" class="btn btn-secondary">info@coltonfouch.com</a>
    </div>

    <div class="plate">
      <figure class="plate-figure">
        <img
          src="/brand/fouch-avatar-cream-fullbody.jpg"
          alt="Clay portrait of Colton Fouch in a black hoodie, camouflage cargo pants, and trail sneakers."
          width="864"
          height="1152"
        />
      </figure>
      <dl class="facts" aria-label="Profile summary">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.key}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
