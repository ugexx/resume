---
interface CaseStudy {
  slug: string;
  title: string;
  summary: string;
  outcome: string;
  tags: string[];
}

const studies: CaseStudy[] = [
  {
    slug: "zero-touch",
    title: "Zero-Touch Deployments",
    summary: "A fully automated macOS deployment workflow that replaced manual imaging across 2,000+ endpoints.",
    outcome: "Provisioning cut from hours to under 20 minutes",
    tags: ["Jamf Pro", "Apple Business Manager", "macOS", "Bash"],
  },
  {
    slug: "platform-sso",
    title: "Platform SSO & Identity",
    summary: "Secure Enclave-backed Platform SSO and Jamf Connect least-privilege admin, replacing password-based sign-in.",
    outcome: "Passwordless sign-in, enterprise-wide",
    tags: ["Jamf Connect", "Platform SSO", "Entra ID"],
  },
  {
    slug: "live-streaming",
    title: "Live Streaming Infrastructure",
    summary: "Broadcast-grade streaming for company-wide town halls, integrating OBS, ProPresenter, and Microsoft Teams.",
    outcome: "Hybrid events reaching thousands of employees",
    tags: ["OBS Studio", "ProPresenter", "Teams"],
  },
  {
    slug: "patch-automation",
    title: "Patch Automation",
    summary: "macOS and iOS patch strategy in Jamf Pro with automated compliance reporting and remediation.",
    outcome: "Hands-off patch compliance across the fleet",
    tags: ["Jamf Pro", "macOS", "iOS"],
  },
  {
    slug: "content-caching",
    title: "Content Caching",
    summary: "Apple Content Caching servers across key network segments to keep software delivery local.",
    outcome: "Lower WAN bandwidth, faster installs",
    tags: ["Content Caching", "DNS/DHCP", "Networking"],
  },
];
---

<section id="work" class="section">
  <div class="container-x">
    <h2>Featured Work</h2>

    <ol class="work-list">
      {studies.map((s) => (
        <li>
          <a href={`/case-studies/${s.slug}`} class="work-row">
            <h3 class="work-title">
              {s.title}
              <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
            </h3>
            <div class="work-copy">
              <p class="work-summary">{s.summary}</p>
              <ul class="tags" aria-label="Stack">
                {s.tags.map((t, i) => (
                  <li class="tag">
                    {t}{i < s.tags.length - 1 && <span class="tag-sep" aria-hidden="true">&nbsp;·&nbsp;</span>}
                  </li>
                ))}
              </ul>
            </div>
            <p class="work-outcome">{s.outcome}</p>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
