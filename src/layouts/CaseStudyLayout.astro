---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  metric: string;
  metricLabel: string;
}

const { title, description, metric, metricLabel } = Astro.props;
---

<Base title={`${title} — Colton Fouch`} description={description}>
  <Nav />
  <main id="content">
    <article class="container-x case-top">
      <a href="/#work" class="back-link">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 8H3M7.5 3.5 3 8l4.5 4.5" /></svg>
        Work
      </a>

      <h1>{title}</h1>
      <p class="case-dek">{description}</p>

      <p class="metric">
        <span class="metric-label">{metricLabel}</span>
        <span class="metric-value">{metric}</span>
      </p>

      <div class="case-body">
        <slot />
      </div>

      <footer class="case-end">
        <a href="/#work">All case studies</a>
        <a href="mailto:info@coltonfouch.com">info@coltonfouch.com</a>
      </footer>
    </article>
  </main>
  <Footer />
</Base>
