---
const items = [
  {
    kind: "Workshop",
    title: "Zero-Touch Deployment Workshop",
    desc: "Internal training for IT staff on the zero-touch workflow: Jamf Setup Manager, ABM integration, and troubleshooting common provisioning scenarios.",
  },
  {
    kind: "Mentorship",
    title: "IT Career Mentorship",
    desc: "Mentoring early-career IT professionals at Patagonia through the move from helpdesk to systems administration and beyond.",
  },
  {
    kind: "Community",
    title: "Jamf Nation",
    desc: "Sharing deployment patterns and troubleshooting insights with fellow Mac administrators.",
  },
];
---

<section id="community" class="container-x py-[clamp(48px,8vw,100px)]">
  <h2 class="section-head">Teaching &amp; community</h2>

  <ul class="grid md:grid-cols-3 gap-4">
    {items.map((it) => (
      <li class="card p-6">
        <p class="font-mono text-[12px] text-accent-text">{it.kind}</p>
        <h3 class="mt-2 text-[17px] font-semibold tracking-[-0.015em]">{it.title}</h3>
        <p class="mt-2.5 text-[14.5px] leading-[1.65] text-text-dim">{it.desc}</p>
      </li>
    ))}
  </ul>
</section>
