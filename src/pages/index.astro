---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import CaseStudies from "../components/CaseStudies.astro";
import ArchitectureDecisions from "../components/ArchitectureDecisions.astro";
import CareerNarrative from "../components/CareerNarrative.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Speaking from "../components/Speaking.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title = "Colton Fouch — Senior Platform Manager";
const description =
  "Senior Platform Manager at Patagonia — MDM architect, endpoint strategist, and live production engineer based in Ventura, CA.";
---

<Base title={title} description={description}>
  <Nav />
  <main>
    <Hero />
    <CaseStudies />
    <ArchitectureDecisions />
    <CareerNarrative />
    <Experience />
    <Skills />
    <Speaking />
    <Contact />
  </main>
  <Footer />
</Base>
