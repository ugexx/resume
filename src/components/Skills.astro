---
interface Skill {
  cat: string;
  items: string[];
}

const skills: Skill[] = [
  { cat: "MDM", items: ["Jamf Pro", "Jamf Connect", "Intune", "SCCM", "Apple Business Manager"] },
  { cat: "Platforms", items: ["macOS", "iOS/iPadOS", "Windows", "Apple Silicon"] },
  { cat: "Identity", items: ["Entra ID", "Active Directory", "Platform SSO", "Secure Enclave"] },
  { cat: "Network", items: ["Palo Alto", "DNS/DHCP", "SSL Inspection", "Content Caching"] },
  { cat: "Automation", items: ["PowerShell", "Bash", "Copilot Studio", "1Password CLI"] },
  { cat: "Production", items: ["OBS Studio", "ProPresenter", "Microsoft Teams", "A/V Hardware"] },
];

const certs = ["Jamf Certified Tech", "Jamf Certified Admin", "CompTIA Network+"];
---

<section id="stack" class="section">
  <div class="container-x">
    <h2>Stack</h2>

    <div class="sheet">
      <div class="skill-grid">
        {skills.map((s) => (
          <div>
            <h3 class="skill-cat">{s.cat}</h3>
            <p class="skill-items">{s.items.join(", ")}</p>
          </div>
        ))}
      </div>

      <div>
        <h3 class="skill-cat">Certifications</h3>
        <ul class="certs">
          {certs.map((c) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>
              {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
