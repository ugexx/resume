---
interface Role {
  company: string;
  role: string;
  dates: string;
  desc: string;
  tags: string[];
}

const roles: Role[] = [
  {
    company: "Patagonia · Ventura, CA",
    role: "Senior Platform Manager",
    dates: "Jul 2026 — Present",
    desc: "Own enterprise endpoint strategy and live production infrastructure supporting a global hybrid workforce. Lead MDM architecture across Jamf Pro and Intune for 2,000+ endpoints.",
    tags: ["Jamf Pro", "Intune", "Entra ID", "OBS", "Palo Alto"],
  },
  {
    company: "Patagonia · Ventura, CA",
    role: "Platform Manager",
    dates: "Oct 2023 — Jul 2026",
    desc: "Engineered zero-touch deployment workflows that cut provisioning from hours to under 20 minutes. Rolled out Platform SSO for passwordless sign-in and built the live streaming setup for company-wide town halls.",
    tags: ["Jamf Pro", "Intune", "OBS", "PowerShell", "Bash"],
  },
  {
    company: "Patagonia · Ventura, CA",
    role: "IT System Administrator II",
    dates: "Oct 2022 — Oct 2023",
    desc: "Managed a hybrid Windows and macOS environment spanning 2,000+ endpoints. Developed automated deployment scripts, configuration profiles, and patch workflows.",
    tags: ["Jamf Pro", "SCCM", "Intune", "PowerShell", "Bash"],
  },
  {
    company: "Patagonia · Ventura, CA",
    role: "IT Systems Analyst",
    dates: "Sep 2018 — Oct 2022",
    desc: "Provided end-user support for headquarters and remote employees across North America. Supported rapid pandemic-driven expansion of the hybrid work model.",
    tags: ["Zendesk", "Jamf Pro", "SCCM"],
  },
  {
    company: "Guitar Center · Westlake Village, CA",
    role: "IT Helpdesk Technician",
    dates: "Oct 2016 — Sep 2018",
    desc: "Delivered technical support for corporate headquarters and 280+ retail locations nationwide. Managed the Mac fleet using Jamf Pro.",
    tags: ["Active Directory", "Jamf Pro", "Hardware"],
  },
];
---

<section id="experience" class="section">
  <div class="container-x">
    <h2>Experience</h2>

    <ol class="ledger">
      {roles.map((r) => (
        <li>
          <p class="ledger-date">{r.dates}</p>
          <div>
            <h3 class="role-title">{r.role}</h3>
            <p class="role-place">{r.company}</p>
            <p class="role-desc">{r.desc}</p>
            <ul class="tags" aria-label="Tools">
              {r.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
